# Local development uses same-origin `/api` through the Vite proxy.
VITE_PROXY_TARGET=http://localhost:4000

# Optional error telemetry. Leave unset to disable locally.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# Optional Sentry source map upload for release builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
