# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# LOG_LEVEL: Pino structured logging level. Valid: fatal, error, warn, info, debug, trace, silent
# Defaults: debug (development), info (production), silent (test)
# Leave unset to use environment-based default
LOG_LEVEL=debug

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://uniconnect:uniconnect@localhost:5433/uniconnect_dev

# ─── JWT Secrets (min 32 characters each) ──────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Password Reset ───────────────────────────────────────────────────────
RESET_PASSWORD_SECRET=change-me-reset-secret-at-least-32-chars
RESET_PASSWORD_EXPIRY=1h

# ─── Resend (Email) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Cloudinary ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── CORS (comma-separated for multiple origins) ──────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Cookie and CSRF Protection ───────────────────────────────────────────
CSRF_ENABLED=true
CSRF_SECRET=change-me-csrf-secret-at-least-32-chars
CSRF_TRUSTED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SAME_SITE=strict
AUTH_COOKIE_SECURE=auto

# ─── Optional Error Telemetry ───────────────────────────────────────────────
# Leave SENTRY_DSN unset to disable telemetry locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
