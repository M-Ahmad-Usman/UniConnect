{
  "name": "uniconnect-server",
  "version": "1.0.0",
  "description": "",
  "author": "M-Ahmad-Usman",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "npm run build && node dist/index.js",
    "lint": "eslint .",
    "migrate:latest": "tsx src/db/migrator.ts latest",
    "migrate:up": "tsx src/db/migrator.ts up",
    "migrate:down": "tsx src/db/migrator.ts down",
    "create:migration": "tsx src/db/migrator.ts create",
    "get:migrations": "tsx src/db/migrator.ts get:migrations",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "eslint": "^10.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "kysely": "^0.28.11",
    "pg": "^8.19.0",
    "zod": "^4.3.6"
  }
}
