{
  "name": "uniconnect-server",
  "version": "1.0.0",
  "description": "",
  "author": "M-Ahmad-Usman",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "npm run build && node dist/index.js",
    "lint": "eslint .",
    "migrate:latest": "tsx src/db/migrator.ts latest",
    "migrate:up": "tsx src/db/migrator.ts up",
    "migrate:down": "tsx src/db/migrator.ts down",
    "create:migration": "tsx src/db/migrator.ts create",
    "get:migrations": "tsx src/db/migrator.ts get:migrations",
    "test": "vitest",
    "test:integration": "vitest integration",
    "test:unit": "vitest unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.0.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.11",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  }
}
